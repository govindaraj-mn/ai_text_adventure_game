# Copy to .env and fill in. Never commit .env.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_MAX_TOKENS=2000
LLM_JSON_MODE=1

# Stable HMAC secret so a reloaded client can recover a run across restarts.
STATE_SECRET=

# Optional switches
# TURN_RATE_LIMIT=30
# START_RATE_LIMIT=15
# DISABLE_EVENTS=0
# DISABLE_LLM=0
# LLM_THINKING=1
